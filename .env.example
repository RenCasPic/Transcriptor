# --- Supabase ---
# URL pública del proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (pública) de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (privada, NUNCA exponer al cliente). Solo se usa en Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de generación de contenido con IA ---
# Valores soportados: "mock" (sin costo, reorganiza tu transcripción real sin redactar) | "groq" (gratis,
# redacta con un modelo real) | "anthropic" | "openai"
# "groq" (https://console.groq.com) da artículos mucho más profesionales que "mock", gratis dentro de un
# límite de uso razonable y sin tarjeta de crédito. Puede usar la misma API key que TRANSCRIPTION_API_KEY
# si también pusiste TRANSCRIPTION_PROVIDER=groq.
AI_PROVIDER=mock
# Clave del proveedor seleccionado (no requerida si AI_PROVIDER=mock)
AI_API_KEY=
# Modelo a utilizar por el proveedor configurado (opcional, cada proveedor trae un default razonable)
AI_MODEL=

# --- Imagen de portada automática (opcional) ---
# API key gratuita de Pexels (https://www.pexels.com/api), sin tarjeta de crédito, aprobación instantánea.
# Sin esta clave, los artículos se generan sin imagen de portada (el resto de la app funciona igual).
PEXELS_API_KEY=

# --- Transcripción de audio/video ---
# Valores soportados: "demo" (transcripción de ejemplo, sin API externa) | "groq" | "whisper"
# "groq" usa la API de Groq (https://console.groq.com), gratis dentro de un límite de uso razonable,
# sin tarjeta de crédito: crea una cuenta, genera una API key en "API Keys" y pégala abajo.
# "whisper" usa la API de Whisper de OpenAI (https://platform.openai.com/docs/guides/speech-to-text),
# con costo por minuto transcrito. Ambos comparten el mismo límite de 25 MB por archivo.
TRANSCRIPTION_PROVIDER=demo
# API key del proveedor elegido arriba (no requerida si TRANSCRIPTION_PROVIDER=demo).
# Con TRANSCRIPTION_PROVIDER=whisper puede ser la misma que AI_API_KEY si también usas AI_PROVIDER=openai.
TRANSCRIPTION_API_KEY=

# --- Aplicación ---
APP_URL=http://localhost:3000

# --- Cifrado de credenciales de integraciones (WordPress, etc.) ---
# Cadena aleatoria de 32 bytes en base64 usada para cifrar encrypted_credentials en la tabla integrations.
INTEGRATIONS_ENCRYPTION_KEY=
