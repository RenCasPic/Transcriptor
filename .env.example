# --- Supabase ---
# URL pública del proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (pública) de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (privada, NUNCA exponer al cliente). Solo se usa en Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de generación de contenido con IA ---
# Valores soportados: "mock" (sin costo, para desarrollo/demo) | "anthropic" | "openai"
AI_PROVIDER=mock
# Clave del proveedor seleccionado (no requerida si AI_PROVIDER=mock)
AI_API_KEY=
# Modelo a utilizar por el proveedor configurado (opcional, cada proveedor trae un default razonable)
AI_MODEL=

# --- Transcripción de audio/video ---
# Valores soportados: "demo" (transcripción de ejemplo, sin API externa) | "whisper"
# "whisper" usa la API de Whisper de OpenAI (https://platform.openai.com/docs/guides/speech-to-text).
# Tiene costo por minuto transcrito y un límite de 25 MB por archivo.
TRANSCRIPTION_PROVIDER=demo
# API key de OpenAI (requerida si TRANSCRIPTION_PROVIDER=whisper). Puede ser la misma que AI_API_KEY
# si también usas AI_PROVIDER=openai.
TRANSCRIPTION_API_KEY=

# --- Aplicación ---
APP_URL=http://localhost:3000

# --- Cifrado de credenciales de integraciones (WordPress, YouTube, etc.) ---
# Cadena aleatoria de 32 bytes en base64 usada para cifrar encrypted_credentials en la tabla integrations.
INTEGRATIONS_ENCRYPTION_KEY=

# --- Integración OAuth con YouTube (importar subtítulos del canal propio) ---
# Credenciales OAuth 2.0 de un proyecto en Google Cloud Console con la
# "YouTube Data API v3" habilitada. Ver README.md para los pasos completos.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
