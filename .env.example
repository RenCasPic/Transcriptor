# --- Supabase ---
# URL pública del proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (pública) de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (privada, NUNCA exponer al cliente). Solo se usa en Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- API key de Groq (recomendada: cubre transcripción + generación) ---
# Crea una clave GRATIS en https://console.groq.com (sin tarjeta de crédito) y pégala aquí.
# Se usa como fallback tanto para AI_API_KEY como para TRANSCRIPTION_API_KEY, así que con
# solo esta variable y AI_PROVIDER=groq / TRANSCRIPTION_PROVIDER=groq la app queda operativa.
GROQ_API_KEY=

# --- Proveedor de generación de artículos con IA ---
# Valores soportados: "groq" | "anthropic" | "openai". Requiere una API key
# (AI_API_KEY, o GROQ_API_KEY si AI_PROVIDER=groq). Sin clave -> error explícito.
#
# ⚠️ IMPORTANTE sobre Groq: el plan GRATUITO ("on_demand") limita a ~8000
# tokens/minuto por modelo. La TRANSCRIPCIÓN de audio cabe, pero GENERAR el
# artículo a partir de una transcripción de más de ~5-6 min supera ese límite
# (error "413 Request too large") y NO hay forma de sortearlo en ese plan.
# Para usar la app con contenido real, elige una de estas:
#   (a) activa el DEV TIER de Groq (gratis, solo pide verificar identidad con
#       una tarjeta; no cobra dentro de límites generosos) -> sube el TPM ~25x;
#   (b) AI_PROVIDER=openai con una AI_API_KEY de OpenAI (gpt-4o-mini es muy
#       barato: fracciones de céntimo por artículo);
#   (c) AI_PROVIDER=anthropic con una AI_API_KEY de Anthropic.
AI_PROVIDER=groq
# Clave específica del proveedor de IA. Si usas Groq puedes dejarla vacía y poner solo GROQ_API_KEY.
AI_API_KEY=
# Modelo del proveedor (opcional). Default para groq: "openai/gpt-oss-120b".
AI_MODEL=
# Tope de tokens de salida al generar el artículo (default 5000). Bájalo si tu plan de IA
# tiene un límite de tokens/minuto muy bajo; súbelo si generas artículos muy largos.
AI_ARTICLE_MAX_TOKENS=5000

# --- Imagen de portada automática (opcional) ---
# API key gratuita de Pexels (https://www.pexels.com/api), sin tarjeta de crédito, aprobación instantánea.
# Sin esta clave, los artículos se generan sin imagen de portada (el resto de la app funciona igual).
PEXELS_API_KEY=

# --- Transcripción de audio/video ---
# Valores soportados: "groq" (gratis) | "whisper" (OpenAI, con costo por minuto).
# Requiere una API key (TRANSCRIPTION_API_KEY, o GROQ_API_KEY si TRANSCRIPTION_PROVIDER=groq).
# Sin clave, subir audio/video o el fallback de YouTube devuelven un error explícito.
# Ambos proveedores comparten el mismo límite de 25 MB por petición (la app trocea automáticamente
# los archivos más grandes, ver más abajo).
TRANSCRIPTION_PROVIDER=groq
# Clave específica del proveedor de transcripción. Si usas Groq puedes dejarla vacía y poner solo GROQ_API_KEY.
TRANSCRIPTION_API_KEY=

# --- Archivos de audio/video grandes ---
# Flujo: el NAVEGADOR extrae y comprime el audio con ffmpeg.wasm (MP3 mono 16 kHz
# 32 kbps) ANTES de subir -> un podcast de 50 min pasa a ~12 MB -> se sube DIRECTO
# a Supabase Storage (signed upload URL, sin pasar por una Server Action) -> se
# transcribe en segundo plano (generation_jobs).
#
# Tamaño máx. (MB) del archivo que el usuario puede ELEGIR (antes de extraer el
# audio). Un video de 50 min puede pesar cientos de MB; solo se sube el audio.
MEDIA_MAX_SOURCE_MB=2000
# Tamaño máx. (MB) del archivo QUE SE SUBE (audio ya comprimido). El límite
# EFECTIVO es el MENOR entre este valor y el límite GLOBAL de subida de tu
# proyecto Supabase (Dashboard -> Storage -> Settings): 50 MB en el plan gratuito,
# hasta 50 GB en planes de pago. El bucket (migración 0020) deja file_size_limit
# en NULL para heredar ese global.
MEDIA_MAX_UPLOAD_MB=50
# Si el archivo elegido es AUDIO y pesa menos que esto, se sube tal cual sin
# pasar por ffmpeg.wasm (camino simple para audios chicos).
MEDIA_CLIENT_EXTRACT_THRESHOLD_MB=15
# Duración máxima (segundos) de un archivo a procesar (por defecto 6 h).
MEDIA_MAX_DURATION_SECONDS=21600
# Troceado de audio cuando el archivo supera el límite POR PETICIÓN del
# proveedor de transcripción (25 MB en Whisper/Groq). Se extrae el audio con
# ffmpeg y se parte en chunks mono; cada chunk se transcribe por separado y
# luego se recompone una única transcripción con timestamps corregidos.
MEDIA_CHUNK_TARGET_MB=20
MEDIA_CHUNK_MAX_SECONDS=600
MEDIA_CHUNK_AUDIO_BITRATE_KBPS=64
# Rutas a ffmpeg/ffprobe. Por defecto se usan los binarios estáticos de
# @ffmpeg-installer/ffmpeg y @ffprobe-installer/ffprobe (ya en package.json);
# defínelas solo si quieres usar otros binarios del sistema.
FFMPEG_PATH=
FFPROBE_PATH=
# Secreto del worker/cron que drena jobs de transcripción encolados o colgados
# (POST /api/jobs/transcription con cabecera "x-jobs-secret"). Sin este valor
# el endpoint está deshabilitado; el procesamiento sigue ocurriendo vía
# after() dentro de la misma invocación que encola el job.
JOBS_WORKER_SECRET=

# --- Import de YouTube sin subtítulos (opcional) ---
# Si un video de YouTube no tiene subtítulos, se extrae su audio (vía la librería no oficial
# "@distube/ytdl-core") y se transcribe con el proveedor configurado (TRANSCRIPTION_PROVIDER). No
# requiere ninguna clave nueva: reutiliza TRANSCRIPTION_API_KEY / GROQ_API_KEY. Sin clave de
# transcripción configurada, este fallback devuelve un error explícito.
# Duración máxima en segundos de video a la que se le extrae audio (por defecto 5400 = 90 min).
YOUTUBE_AUDIO_MAX_DURATION_SECONDS=5400
# La app fija YTDL_NO_DEBUG_FILE=1 en tiempo de ejecución para que @distube/ytdl-core no escriba
# archivos "<timestamp>-player-script.js" en el directorio de trabajo cuando no logra parsear el
# reproductor de YouTube. Si necesitas ese archivo para reportar un problema a la librería, define
# YTDL_NO_DEBUG_FILE= (vacío) explícitamente en tu .env.local — la app solo fija el valor por
# defecto cuando la variable no existe en absoluto, así que un valor vacío ya puesto no se pisa.

# --- Aplicación ---
APP_URL=http://localhost:3000

# --- Cifrado de credenciales de integraciones (WordPress, etc.) ---
# Cadena aleatoria de 32 bytes en base64 usada para cifrar encrypted_credentials en la tabla integrations.
INTEGRATIONS_ENCRYPTION_KEY=
